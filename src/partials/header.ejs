<header>
    <div class="header-wrapper">
        <div class="container">
            <div class="row">
                <div class="col">
                    <div class="header-content">
                        <a href="<%= baseUrl %>" class="logo">
                            <div class="logo-wrapper">
                                <img src="/svg/logo.svg" alt="" class="logo-thumb" />
                            </div>
                            <h3 class="logo-name">Justice</h3>
                            <p class="paragraph">Law Firm</p>
                        </a>
                        <label for="checkbox-menu" class="md__menu-icon">
                            <i class="fa-solid fa-bars"></i>
                        </label>
                        <input type="checkbox" class="md__menu-checkbox" id="checkbox-menu" hidden />
                        <label for="checkbox-menu" class="overlay"></label>
                        <nav>
                            <label for="checkbox-menu" class="menu-close__icon">
                                <i class="fa-solid fa-xmark"></i>
                            </label>
                            <ul class="nav-list">
                                <li class="nav-item">
                                    <a href="<%= baseUrl %>">
                                        Home
                                        <i class="fa-solid fa-chevron-down"></i>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a href="<%= baseUrl %>pages/about.html">
                                        About
                                        <i class="fa-solid fa-chevron-down"></i>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a href="">
                                        Practice Areas
                                        <i class="fa-solid fa-chevron-down"></i>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a href="">
                                        Attorneys
                                        <i class="fa-solid fa-chevron-down"></i>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a href="">
                                        Page
                                        <i class="fa-solid fa-chevron-down"></i>
                                    </a>
                                </li>
                            </ul>
                        </nav>
                        <div class="contact-number">
                            <p class="paragraph">Call:</p>
                            <a href="tel:1234567890" class="paragraph-medium">(000) 123-456-7890</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</header>
